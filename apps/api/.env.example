NODE_ENV=development
PORT=3000

# Postgres local via docker-compose (ver docker-compose.yml na raiz do monorepo)
DATABASE_URL="postgresql://auth:auth@localhost:5432/auth_system?schema=public"

# Mailhog local via docker-compose (UI em http://localhost:8025). Em produção,
# trocar pelas credenciais SMTP do Resend.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@auth-system.local

# Origem do front-end, usada para montar o link enviado no e-mail de verificação
FRONTEND_URL=http://localhost:5173

# Origens permitidas pelo CORS, separadas por vírgula.
# Em produção liste todos os domínios do front-end.
CORS_ORIGINS=http://localhost:5173

# Redis — usado pelo ThrottlerModule e pelo blocklist de access tokens (plano 002).
# Em produção, use uma URL com auth: redis://:senha@host:6379
REDIS_URL=redis://localhost:6379

# Segredo de assinatura do access token (HS256). Mínimo 32 caracteres.
# Gerar um valor real com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
