{
  "name": "auth-system",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=api --if-present",
    "test:e2e": "npm run test:e2e --workspace=api --if-present",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,js,mjs}": "eslint --fix --config apps/api/eslint.config.mjs",
    "apps/web/**/*.{ts,tsx,js,mjs}": "eslint --fix --config apps/web/eslint.config.mjs",
    "packages/shared/**/*.{ts,js,mjs}": "eslint --fix --config packages/shared/eslint.config.mjs",
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  }
}
